# ==============================================================================
# SPWM-Collab - Private Storage Protection
# Deny all direct HTTP requests to private storage (logs, sessions, cache)
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes -ExecCGI
