# ==============================================================================
# SPWM-Collab - Framework Bootstrap & Cache Protection
# Deny all direct HTTP requests to cached configuration and routes
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes -ExecCGI
